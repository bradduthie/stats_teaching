YY      <- dat[["Leaf_width"]][ii];
EX      <- dat[["Leaf_length_error"]][ii];
EY      <- dat[["Leaf_width_error"]][ii];
ZZ      <- XX * YY;
EZ      <- ZZ * sqrt( ((EX/XX)^2) + ((EY/YY)^2) )
ans     <- EZ;
return(ans);
}
Q19_ans <- function(dat){
height <- dat[["Plant_height"]];
isNorm <- shapiro.test(height)$p.value;
if(isNorm < 0.05){
ans <- wilcox.test(x = height, mu = 22, alternative = "greater")$p.value;
}
if(isNorm > 0.05){
ans <- t.test(x = height, mu = 22, alternative = "greater")$p.value;
}
return(ans);
}
Q20_ans <- function(dat){
Elevation <- dat[["Elevation"]];
LN_elev   <- log(Elevation);
sp        <- dat[["Species"]];
sage      <- which(sp == "sage");
rose      <- which(sp == "roseroot");
isNorm    <- shapiro.test(LN_elev)$p.value;
sNorm     <- shapiro.test(LN_elev[sage])$p.value;
rNorm     <- shapiro.test(LN_elev[rose])$p.value;
ans       <- "There is a problem here";
if(isNorm > 0.05 & sNorm > 0.05 & rNorm > 0.05){
Ltst <- leveneTest(LN_elev ~ as.factor(sp));
LtP  <- Ltst[["Pr(>F)"]][1];
if(LtP < 0.05){
tt  <- t.test(LN_elev ~ sp, var.equal = FALSE);
ans <- as.numeric(tt$p.value);
}
if(LtP > 0.05){
tt  <- t.test(LN_elev ~ sp, var.equal = TRUE);
ans <- as.numeric(tt$p.value);
}
}
return(ans);
}
Q21_ans <- function(dat){
dry_mass  <- dat[["Leaf_dry_mass"]];
isNorm    <- shapiro.test(dry_mass)$p.value;
ans       <- "There is a problem here."
if(isNorm > 0.05){
the_p <- t.test(dry_mass, mu = 40)$p.value;
if(the_p < 0.05){
ans <- "Type I error";
}
if(the_p > 0.05){
ans <- "There would be no error in this case";
}
}
return(ans);
}
Q22_ans <- function(dat){
dry_mass  <- dat[["Leaf_dry_mass"]];
N         <- dim(dat)[1];
ans       <- sd(dry_mass) / sqrt(N);
return(ans);
}
Q23_ans <- function(dat){
dry_mass  <- dat[["Leaf_dry_mass"]];
sp        <- dat[["Species"]];
Loc       <- dat[["Location"]];
use       <- which(sp == "sage" & Loc == "Grassland");
dm_mu     <- mean(dry_mass[use]);
dm_se     <- sd(dry_mass[use]) / sqrt(length(dry_mass[use]));
ans       <- dm_mu + (2.58 * dm_se);
return(ans);
}
Q24_ans <- function(dat){
N      <- dim(dat)[1];
herb   <- dat[["Herbivory"]];
Yes    <- sum(herb == "Yes");
No     <- sum(herb == "No");
prbY   <- Yes / N;
prbN   <- No / N;
ans    <- 4 * prbY * prbN * prbN * prbN;
return(ans);
}
Q25_ans <- function(dat){
polls  <- dat[["Pollinators"]];
lambp  <- mean(polls);
l3     <- ppois(q = 3, lambda = lambp);
l2     <- ppois(q = 2, lambda = lambp);
ans    <- l3 - l2;
return(ans);
}
