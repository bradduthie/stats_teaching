count_to_1_billion <- function(){
for(i in 1:1000000000){
if(i %% 100000000 == 0){
print(i);
}
}
return("Done!");
}
count_to_1_billion()
install.packages("car")
# Set up an empty plot area
plot(1, type = "n", xlim = c(0, 100), ylim = c(0, 100),
xlab = "", ylab = "", axes = FALSE, main = "Cartoon Cow")
# Set up an empty plot area
plot(1, type = "n", xlim = c(0, 100), ylim = c(0, 100),
xlab = "", ylab = "", axes = FALSE, main = "Cartoon Cow")
# Draw body (main shape)
body_x <- c(40, 60, 65, 60, 40, 35)
body_y <- c(40, 40, 50, 60, 60, 50)
polygon(body_x, body_y, col = "white", border = "black", lwd = 2)
# Draw head
head_x <- c(60, 75, 70, 60)
head_y <- c(50, 55, 65, 60)
polygon(head_x, head_y, col = "white", border = "black", lwd = 2)
# Draw muzzle
muzzle_x <- c(70, 78, 75, 70)
muzzle_y <- c(58, 58, 63, 63)
polygon(muzzle_x, muzzle_y, col = "pink", border = "black", lwd = 1.5)
# Draw nostrils
points(72, 60, pch = 19, cex = 0.8, col = "black")
points(75, 60, pch = 19, cex = 0.8, col = "black")
# Draw eyes
eye_x <- 68
eye_y <- 62
points(eye_x, eye_y, pch = 19, cex = 1.2, col = "black")
points(eye_x+0.3, eye_y+0.3, pch = 19, cex = 0.4, col = "white") # highlight
# Draw ears
ear_x <- c(75, 80, 78)
ear_y <- c(55, 53, 58)
polygon(ear_x, ear_y, col = "pink", border = "black", lwd = 1.5)
ear2_x <- c(62, 65, 60)
ear2_y <- c(62, 65, 64)
polygon(ear2_x, ear2_y, col = "pink", border = "black", lwd = 1.5)
# Draw horns
horn_x <- c(72, 73, 74)
horn_y <- c(57, 59, 57)
polygon(horn_x, horn_y, col = "tan", border = "black", lwd = 1)
horn2_x <- c(65, 66, 67)
horn2_y <- c(63, 65, 63)
polygon(horn2_x, horn2_y, col = "tan", border = "black", lwd = 1)
# Draw legs
legs_x <- list(
c(40, 38, 37, 39),  # back left
c(45, 43, 42, 44),  # back right
c(55, 53, 52, 54),  # front left
c(60, 58, 57, 59)   # front right
)
legs_y <- list(
c(40, 30, 32, 42),  # back left
c(40, 30, 32, 42),  # back right
c(40, 30, 32, 42),  # front left
c(40, 30, 32, 42)   # front right
)
for(i in 1:4) {
polygon(legs_x[[i]], legs_y[[i]], col = "white", border = "black", lwd = 1.5)
}
# Draw hooves
hooves_x <- list(
c(38, 37, 37, 38),
c(43, 42, 42, 43),
c(53, 52, 52, 53),
c(58, 57, 57, 58)
)
hooves_y <- list(
c(30, 30, 32, 32),
c(30, 30, 32, 32),
c(30, 30, 32, 32),
c(30, 30, 32, 32)
)
for(i in 1:4) {
polygon(hooves_x[[i]], hooves_y[[i]], col = "black", border = "black", lwd = 1)
}
# Draw udder
udder_x <- c(45, 50, 55, 50)
udder_y <- c(40, 37, 40, 43)
polygon(udder_x, udder_y, col = "pink", border = "black", lwd = 1)
# Draw tail
tail_x <- c(35, 30, 32, 33)
tail_y <- c(50, 45, 47, 52)
polygon(tail_x, tail_y, col = "white", border = "black", lwd = 1)
# Add tail tuft
lines(c(30, 28), c(45, 43), lwd = 1.5, col = "black")
lines(c(30, 29), c(45, 41), lwd = 1.5, col = "black")
lines(c(30, 31), c(45, 42), lwd = 1.5, col = "black")
# Add cow spots (random black patches)
spots_x <- list(
c(42, 48, 47, 43),
c(50, 55, 54, 51),
c(45, 50, 49, 46),
c(55, 58, 60, 56),
c(62, 65, 67, 63)
)
spots_y <- list(
c(45, 47, 52, 50),
c(45, 43, 48, 47),
c(55, 57, 52, 53),
c(55, 53, 50, 52),
c(55, 53, 50, 52)
)
for(i in 1:5) {
polygon(spots_x[[i]], spots_y[[i]], col = "black", border = "black", lwd = 1)
}
# Add a friendly smile
smile_x <- c(71, 74, 76)
smile_y <- c(57, 56, 57)
lines(spline(smile_x, smile_y, n=20), lwd=1.5, col="black")
# Add grass ground
grass_x <- seq(25, 75, by=2)
grass_y <- rep(30, length(grass_x))
segments(grass_x, grass_y, grass_x, grass_y - runif(length(grass_x), 2, 5),
col = "green", lwd = 1.5)
# Add some decorative elements
# Sun in corner
sun_x <- 85
sun_y <- 85
points(sun_x, sun_y, pch=19, cex=3, col="yellow")
rays <- seq(0, 2*pi, length=12)
for(i in rays) {
lines(c(sun_x, sun_x+5*cos(i)), c(sun_y, sun_y+5*sin(i)), col="yellow", lwd=2)
}
# Add a thought bubble
thought_x <- c(78, 85, 83, 78)
thought_y <- c(65, 68, 72, 70)
lines(thought_x, thought_y, lwd=1.5, col="gray", lty=2)
points(85, 75, pch=21, cex=2, col="gray", lwd=1.5)
points(87, 78, pch=21, cex=1.5, col="gray", lwd=1.5)
text(80, 67, "Moo!", col="black", cex=0.8)
# Set up an empty plot area
plot(1, type = "n", xlim = c(0, 10), ylim = c(0, 10),
xlab = "", ylab = "", axes = FALSE, main = "Colorful Bird")
# Draw body (filled ellipse)
t <- seq(0, 2*pi, length.out = 100)
x_body <- 5 + 3*cos(t)
y_body <- 5 + 2*sin(t)
polygon(x_body, y_body, col = "lightblue", border = "darkblue", lwd = 2)
# Draw head (filled circle)
x_head <- 8 + 1*cos(t)
y_head <- 5.5 + 1*sin(t)
polygon(x_head, y_head, col = "lightblue", border = "darkblue", lwd = 2)
# Draw beak (triangle)
beak_x <- c(9, 9.5, 9)
beak_y <- c(5.5, 5.5, 5)
polygon(beak_x, beak_y, col = "orange", border = "black", lwd = 2)
# Draw eye
points(8.2, 5.8, pch = 19, cex = 1.2, col = "black")
points(8.3, 5.9, pch = 19, cex = 0.4, col = "white") # highlight
# Draw single larger wing (curved)
wing_x <- seq(3, 7, length.out = 50)
wing_y <- 4 + 2*sin(seq(0, pi, length.out = 50)) + 0.5*sin(seq(0, 3*pi, length.out = 50))
lines(wing_x, wing_y, lwd = 3, col = "darkblue")
polygon(c(wing_x, rev(wing_x)), c(wing_y, rep(4, length(wing_y))),
col = "steelblue1", border = NA)
# Draw tail feathers (multiple feathers)
tail_x1 <- c(2, 1.5, 2.5)
tail_y1 <- c(5, 6, 6)
polygon(tail_x1, tail_y1, col = "steelblue2", border = "darkblue", lwd = 1.5)
tail_x2 <- c(2.5, 2, 3)
tail_y2 <- c(5, 6.2, 6.2)
polygon(tail_x2, tail_y2, col = "steelblue3", border = "darkblue", lwd = 1.5)
tail_x3 <- c(3, 2.5, 3.5)
tail_y3 <- c(5, 5.8, 5.8)
polygon(tail_x3, tail_y3, col = "steelblue1", border = "darkblue", lwd = 1.5)
# Draw legs with more detail
# Main leg parts
segments(4.5, 3, 4.5, 2, lwd = 2, col = "orange")
segments(5.5, 3, 5.5, 2, lwd = 2, col = "orange")
# Feet with toes
toes_x1 <- c(4.5, 4, 4.2, 4.5, 4.8, 5)
toes_y1 <- c(2, 1.5, 1.7, 2, 1.7, 1.5)
lines(toes_x1, toes_y1, lwd = 2, col = "orange")
toes_x2 <- c(5.5, 6, 5.8, 5.5, 5.2, 5)
toes_y2 <- c(2, 1.5, 1.7, 2, 1.7, 1.5)
lines(toes_x2, toes_y2, lwd = 2, col = "orange")
# Add some decorative elements
# Feather details on wing
feather_lines_x <- seq(4, 6, length.out = 5)
for(x in feather_lines_x) {
y_start <- approx(wing_x, wing_y, x)$y
segments(x, 4, x, y_start, lwd = 1, col = "darkblue", lty = "dashed")
}
# Add a branch for the bird to stand on
branch_x <- c(3, 8)
branch_y <- c(1.5, 1.5)
lines(branch_x, branch_y, lwd = 4, col = "brown")
shiny::runApp('Dropbox/teaching/stats_teaching/Quiz4/Rcode')
runApp('Dropbox/teaching/stats_teaching/Quiz4/Rcode')
runApp('Dropbox/teaching/stats_teaching/Quiz4/Rcode')
runApp('Dropbox/teaching/stats_teaching/Quiz4/Rcode')
