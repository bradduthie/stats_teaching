N  <- 40;
Y  <- rnorm(n = N);
X1 <- sample(x = 2022:2025, size = N, replace = TRUE);
X2 <- sample(x = c("A", "B", "C", "D"), size = N, replace = TRUE);
true_mod <- lm(Y ~ X1 + X2 + X1:X2);
mod_coef <- as.numeric(true_mod$coefficients);
iters  <- 9999;
R_COEF <- NULL;
iter   <- 1;
while(iter < iters){
rand_Y    <- sample(x = Y, size = N, replace = FALSE);
rand_mod  <- lm(rand_Y ~ X1 + X2 + X1:X2);
rand_coef <- as.numeric(rand_mod$coefficients);
R_COEF    <- rbind(R_COEF, rand_coef);
iter      <- iter + 1;
}
# Just looking at X2 coefficient, for example
hist(R_COEF[,3]);
arrow(x0 = 500, x1 = 0, y0 = mod_coef[3], y1 = mod_coef[3])
arrows(x0 = 500, x1 = 0, y0 = mod_coef[3], y1 = mod_coef[3])
mod_coef[3]
arrows(y0 = 500, y1 = 0, x0 = mod_coef[3], x1 = mod_coef[3])
# Just looking at X2 coefficient, for example
hist(R_COEF[,3]);
arrows(y0 = 500, y1 = 0, x0 = mod_coef[3], x1 = mod_coef[3],
lwd = 4, col = "blue");
# Just looking at X2 coefficient, for example
hist(R_COEF[,3]);
arrows(y0 = 500, y1 = 0, x0 = mod_coef[3], x1 = mod_coef[3],
lwd = 4, col = "blue");
extreme <- abs(R_COEF[,3] >= mod_coef[3]);
p_val   <- (sum(extreme) + 1) / (iters + 1);
p_val
